# Local development only. Copy to api/.env (gitignored). Passwords here are local-only dev values.
NODE_ENV=development
HOST=127.0.0.1
PORT=8081
# The API connects as hisaab_api, a login role with only hisaab_app's privileges
# (created by `npm run db:bootstrap` after `npm run db:migrate`).
DATABASE_URL=postgres://hisaab_api:hisaab_api_dev_only@127.0.0.1:5434/hisaab?sslmode=disable
# Owner role for dbmate and for integration tests (they create and drop their own database).
MIGRATE_DATABASE_URL=postgres://hisaab:hisaab_dev_only@127.0.0.1:5434/hisaab?sslmode=disable
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:5174
DEV_LOGIN=true
# Sign-in providers (leave empty to hide the button). Redirect URIs to register:
#   http://localhost:5174/api/auth/google/callback  and  http://localhost:5174/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
